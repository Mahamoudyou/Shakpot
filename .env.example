# Configuration Supabase - Shakpot
# Copiez ce fichier en .env.local et remplissez vos vraies valeurs

# URL du projet Supabase (ex: https://xxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"

# Clé anonyme publique (anon key) - visible dans Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre-anon-key-ici"

# Clé secrète service_role - JAMAIS exposée au frontend, uniquement côté serveur
SUPABASE_SERVICE_ROLE_KEY="votre-service-role-key-ici"
